#pragma once

#include <KAI/Core/Config/Base.h>
#include <KAI/Core/Type/Number.h>

#include <utility>
#include "KAI/Core/BasePointer.h"
#include "KAI/Core/Object/Label.h"
#include "KAI/Core/BasePointerBase.h"

KAI_BEGIN

// TODO: this does not need to be a template
template <class Callable>
struct CallableBase : BasePointerBase
{
    using ArgumentTypes = std::vector<Type::Number>;

protected:
    Type::Number returnType_;
    ArgumentTypes arguments_;
    Label name_;

public:
private:
    CallableBase() = default;

public:
private:
    CallableBase(Label n) : name_(std::move(n)) {}

public:
    [[nodiscard]] Type::Number GetReturnType() const
    {
        return returnType_;
    }
    [[nodiscard]] Label GetName() const
    {
        return name_;
    }
    [[nodiscard]] const ArgumentTypes& GetArgumentTypes() const
    {
        return arguments_;
    }
    [[nodiscard]] Type::Number GetArgumentType(int n) const
    {
        return arguments_[n];
    }
    String description;

    [[nodiscard]] Object GetArgumentTypesArray() const;
    /*
	{
		Pointer<Array> args = New<Array>();
		ArgumentTypes::const_iterator A = arguments.begin(), B = arguments.end();
		for (; A != B; ++A)
			args->Append(New(*A));
		return args;
	}
	*/
    friend Callable;
    friend Callable;
};

namespace Type
{
	template <class T>
	struct Traits<CallableBase<T> > : 
	TraitsBase<CallableBase<T> *, Number::Callable, 0> { };
};

KAI_END
